# ==========================================
# FoodVerse AI Backend Configuration Template
# ==========================================

# Application
PROJECT_NAME="FoodVerse AI"
API_V1_STR="/api/v1"

# Security (Change in production!)
SECRET_KEY="replace-with-a-cryptographically-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL="sqlite:///./foodverse.db"

# CORS Allowed Origins
FRONTEND_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

# Upload Limits & Paths
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=120

# AI Model Provider Selection ("groq" | "gemini" | "openai" | "fallback")
LLM_PROVIDER="groq"
VISION_PROVIDER="groq"
SPEECH_PROVIDER="groq"

# AI Provider Credentials
GROQ_API_KEY=""
GEMINI_API_KEY=""
OPENAI_API_KEY=""
USDA_API_KEY=""
